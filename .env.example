# HoneyForge environment — copy to .env and fill in real values. No real secrets here.

# Postgres (compose db service)
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeyforge
DATABASE_URL=postgresql+psycopg://honeyforge:change-me@db:5432/honeyforge
TEST_DATABASE_URL=postgresql+psycopg://honeyforge:change-me@db:5432/honeyforge_test

# Backend
AGENT_TOKEN_SECRET=change-me-too        # HMAC key for hashing per-agent tokens
AGENT_INGEST_SECRET=change-me-ingest-secret  # decoys -> shared agent /ingest
DEV_OPERATOR_TOKEN=change-me-dev-token  # S2 static operator token (perimeter only, ships in Vite bundle)
AGENT_TOKEN=change-me-agent-token       # per-agent token for the seeded 'low' honeypot (used by app.seed + agent)
MEDIUM_AGENT_TOKEN=change-me-medium-agent-token  # per-agent token for the seeded 'medium' honeypot (app.seed + agent-medium)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST_BIND=127.0.0.1

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_OPERATOR_TOKEN=change-me-dev-token

# Agent (shared Python agent)
HF_CENTER_URL=http://backend:8000
HF_AGENT_TOKEN=change-me-agent-token
HF_AGENT_INGEST_SECRET=change-me-ingest-secret
HF_INGEST_PORT=9000                    # internal ingest API (agent_low_net / agent_medium_net only)
HF_SPOOL_PATH=/data/agent-spool.jsonl  # durable JSON Lines event spool

# Low decoy (compose sets these per service in docker-compose.yml)
#   HF_AGENT_URL=http://agent:9000
#   HF_AGENT_INGEST_SECRET=change-me-ingest-secret
#   HF_DECOY_POLL_INTERVAL=15

# Medium decoy (fake HTTP admin panel). Compose runs a second agent instance
# (`agent-medium`, token = MEDIUM_AGENT_TOKEN) on agent_medium_net, so each
# decoy reaches only its own agent; agent_decoy_net was split into agent_low_net
# and agent_medium_net.
#   HF_AGENT_URL=http://agent-medium:9000
#   HF_AGENT_INGEST_SECRET=change-me-ingest-secret
#   HF_DECOY_POLL_INTERVAL=15